# Set a local development password before starting Docker Compose.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
REDIS_URL=redis://redis:6379/0
REDIS_TLS_CA_CERTS=
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_SECONDS=1
OUTBOX_RELAY_BACKOFF_BASE_SECONDS=1
OUTBOX_RELAY_BACKOFF_MAX_SECONDS=300
STREAM_CLAIM_IDLE_MS=60000
STREAM_MAX_DELIVERIES=5
BACKUP_OBJECT_STORAGE_BACKEND=postgres
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_USE_TLS=1
BACKUP_S3_VERIFY_TLS=1
BACKUP_S3_DELETE_BATCH_SIZE=100
BACKUP_S3_DELETE_BACKOFF_BASE_SECONDS=2
BACKUP_S3_DELETE_BACKOFF_MAX_SECONDS=300
WHATSAPP_ADAPTER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=